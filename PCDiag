

###############################################################################
###                                                                         ###
###    PCDiag-GetGDUSizeInBytes                                             ###
###                                                                         ###
###    Quickly provides file or folder size, in bytes                       ###
###                                                                         ###
###############################################################################

function PCDiag-GetGDUSizeInBytes {
# Quickly provides file or folder size, in bytes
# If not present, downloads gdu_windows_amd64.exe to C:\RTSupport\Utilities\GDU
    param (
        $Path
    )
    # Download GDU if not already there
        $Dir = "C:\RTSupport\Utilities\GDU"
        $Exe = "gdu_windows_amd64.exe"
            if (!(gci "$($Dir)\$($Exe)" -ea SilentlyContinue)) {new-item $Dir -ItemType Directory -Force > $null
                irm https://github.com/dundee/gdu/releases/download/v5.31.0/gdu_windows_amd64.exe.zip -OutFile "$($Dir)\$($Exe).zip"
                Expand-Archive "$($Dir)\$($Exe).zip" "$($Dir)"; remove-item "$($Dir)\$($Exe).zip"
            }
    if (!(test-path $Path)) {return 0}
    $gdu = iex "$($Dir)\$($Exe) -nps --no-prefix `"$($Path)`""
    $bytes = $gdu.split(' ')[0]
    return $bytes
}

###############################################################################
###                                                                         ###
###    PCDIAG-GetLocalProfileSize                                           ###
###                                                                         ###
###    Gets the size on disk of all local user profiles                     ###
###                                                                         ###
###############################################################################


function PCDIAG-GetLocalProfileSize {
    Write-Host "Scanning for local user profiles"
        $GetUserProfiles = Get-CimInstance Win32_UserProfile | where {$_.LocalPath -like "$($env:SystemDrive)\Users\*"} | select LocalPath, LastUseTime
    Write-Host "    $($GetUserProfiles.count) local user profiles found"
    $n=1
    foreach ($UserProfile in $GetUserProfiles) { 
        Write-Host "Profile $($n) of $($GetUserProfiles.count) - Getting profile size of $($UserProfile.LocalPath)"
        $Bytes = (Get-ChildItem -Path $UserProfile.LocalPath -Recurse -File -ErrorAction SilentlyContinue | Measure-Object -Property Length -Sum).Sum
        $LocalUserProfiles += @([PSCustomObject]@{
            LocalPath   = $UserProfile.LocalPath
            LastUsed    = $UserProfile.LastUseTime
            Bytes       =   $Bytes
            MB          =   [math]::Round($Bytes / 1MB,2)
            GB          =   [math]::Round($Bytes / 1GB,2)
        })
    }
    $LocalUserProfiles | Format-Table
    return $LocalUserProfiles
}


###############################################################################
###                                                                         ###
###    PCDiag-DiskCleanup                                                   ###
###                                                                         ###
###    Aggressive cleanup of a system with low disk space                   ###
###                                                                         ###
###############################################################################

Function PCDiag-DiskCleanup {
    if (!(test-path "C:\RTSupport\Logs")) {new-item "C:\RTSupport\Logs" -itemtype Directory -force > $null}

    function Disk-Cleanup {
        <#
        .SYNOPSIS
            Disk space cleanup script for Windows Server 2016 Essentials x64
        
        .DESCRIPTION
            Safely reclaims disk space by cleaning temporary files, old Windows Update
            caches, IIS logs, event logs (archive only), CBS logs, recycle bin, and
            optionally runs the built-in Disk Cleanup utility (cleanmgr).
        
        .NOTES
            - Run as Administrator (enforced by #Requires above)
            - Tested on Windows Server 2016 Essentials x64
            - Review the $DryRun switch before first use
            - Always back up critical data before running cleanup scripts in production
        
        .PARAMETER DryRun
            When $true (default), reports what would be deleted without removing anything.
            Set to $false to perform actual deletion.
        
        .PARAMETER LogPath
            Path for the cleanup log file. Defaults to C:\Logs\DiskCleanup.log
        #>
        
        param(
            [bool]$DryRun   = $true,
            [string]$LogPath = "C:\RTSupport\Logs\DiskCleanup_$(Get-Date -f 'yyyyMMdd_HHmmss').log"
        )
        
        Set-StrictMode -Version Latest
        $ErrorActionPreference = "SilentlyContinue"
        
        # ── Helpers ────────────────────────────────────────────────────────────────────
        
        function Write-Log {
            param([string]$Message, [string]$Level = "INFO")
            $line = "[{0}] [{1}] {2}" -f (Get-Date -f "yyyy-MM-dd HH:mm:ss"), $Level, $Message
            Write-Host $line -ForegroundColor $(if ($Level -eq "WARN") {"Yellow"} elseif ($Level -eq "ERROR") {"Red"} else {"Cyan"})
            $line | Out-File -FilePath $LogPath -Append -Encoding UTF8
        }
        
        function Get-FolderSize {
            param([string]$Path)
            if (-not (Test-Path $Path)) { return 0 }
            (Get-ChildItem $Path -Recurse -Force -ErrorAction SilentlyContinue |
                Measure-Object -Property Length -Sum).Sum
        }
        
        function Format-Bytes {
            param([long]$Bytes)
            switch ($Bytes) {
                { $_ -ge 1GB } { return "{0:N2} GB" -f ($_ / 1GB) }
                { $_ -ge 1MB } { return "{0:N2} MB" -f ($_ / 1MB) }
                { $_ -ge 1KB } { return "{0:N2} KB" -f ($_ / 1KB) }
                default         { return "$_ bytes" }
            }
        }
        
        function Remove-Items {
            param(
                [string]$Path,
                [string]$Description,
                [string]$Filter = "*",
                [bool]$Recurse  = $true,
                [int]$OlderThanDays = 0
            )
            if (-not (Test-Path $Path)) {
                Write-Log "  Skipped (path not found): $Path"
                return 0
            }
        
            $items = Get-ChildItem -Path $Path -Filter $Filter -Recurse:$Recurse -Force -ErrorAction SilentlyContinue
            if ($OlderThanDays -gt 0) {
                $cutoff = (Get-Date).AddDays(-$OlderThanDays)
                $items  = $items | Where-Object { $_.LastWriteTime -lt $cutoff }
            }
        
            $sizeBefore = ($items | Measure-Object -Property Length -Sum).Sum
            if ($null -eq $sizeBefore) { $sizeBefore = 0 }
        
            if ($DryRun) {
                Write-Log "  [DRY-RUN] Would remove $(Format-Bytes $sizeBefore) from: $Description ($Path)"
            } else {
                $items | Remove-Item -Force -Recurse -ErrorAction SilentlyContinue
                Write-Log "  Removed $(Format-Bytes $sizeBefore) from: $Description"
            }
            return $sizeBefore
        }
        
        # ── Setup ──────────────────────────────────────────────────────────────────────
        
        $null = New-Item -ItemType Directory -Path (Split-Path $LogPath) -Force
        $totalFreed = 0
        
        Write-Log ("=" * 60)
        Write-Log "Disk Cleanup Script — Windows Server 2016 Essentials x64"
        Write-Log ("DryRun = $DryRun")
        Write-Log ("=" * 60)
        
        $driveBefore = (Get-PSDrive C).Free
        Write-Log "Free space on C: before cleanup: $(Format-Bytes $driveBefore)"
        
        # ── 1. Windows Temp folders ────────────────────────────────────────────────────
        
        Write-Log "`n[1] Windows Temp Folders"
        $totalFreed += Remove-Items -Path $env:TEMP            -Description "Current user TEMP"   -OlderThanDays 1
        $totalFreed += Remove-Items -Path "C:\Windows\Temp"    -Description "Windows TEMP"         -OlderThanDays 1
        
        # ── 2. Windows Update cache ────────────────────────────────────────────────────
        
        Write-Log "`n[2] Windows Update Download Cache"
        # Stop Windows Update service temporarily (only when not a dry run)
        if (-not $DryRun) {
            Write-Log "  Stopping wuauserv and bits services..."
            Stop-Service -Name wuauserv, bits -Force -ErrorAction SilentlyContinue
            Start-Sleep -Seconds 5
        }
        
        $totalFreed += Remove-Items -Path "C:\Windows\SoftwareDistribution\Download" `
                                    -Description "Windows Update Downloads"
        
        if (-not $DryRun) {
            Write-Log "  Restarting wuauserv and bits services..."
            Start-Service -Name wuauserv, bits -ErrorAction SilentlyContinue
        }
        
        # ── 3. Component Store (WinSxS) cleanup via DISM ──────────────────────────────
        
        Write-Log "`n[3] Component Store (WinSxS) — DISM StartComponentCleanup"
        if ($DryRun) {
            Write-Log "  [DRY-RUN] Would run: DISM /Online /Cleanup-Image /StartComponentCleanup /ResetBase"
        } else {
            Write-Log "  Running DISM cleanup (this may take several minutes)..."
            $dismResult = & DISM.exe /Online /Cleanup-Image /StartComponentCleanup /ResetBase 2>&1
            Write-Log ("  DISM output: " + ($dismResult -join " | "))
        }
        
        # ── 4. CBS (Component-Based Servicing) logs ────────────────────────────────────
        
        Write-Log "`n[4] CBS Logs"
        $totalFreed += Remove-Items -Path "C:\Windows\Logs\CBS" -Description "CBS Logs" -Filter "*.log" -OlderThanDays 7
        
        # ── 5. IIS Logs ────────────────────────────────────────────────────────────────
        
        Write-Log "`n[5] IIS Logs (older than 30 days)"
        $iisLogPaths = @(
            "C:\inetpub\logs\LogFiles",
            "C:\Windows\System32\LogFiles\W3SVC1"
        )
        foreach ($iisPath in $iisLogPaths) {
            $totalFreed += Remove-Items -Path $iisPath -Description "IIS Logs" -Filter "*.log" -OlderThanDays 30
        }
        
        # ── 6. Windows Error Reporting / crash dumps ──────────────────────────────────
        
        Write-Log "`n[6] Windows Error Reporting & Crash Dumps"
        $werPaths = @(
            "C:\ProgramData\Microsoft\Windows\WER\ReportArchive",
            "C:\ProgramData\Microsoft\Windows\WER\ReportQueue",
            "$env:LOCALAPPDATA\Microsoft\Windows\WER\ReportArchive",
            "$env:LOCALAPPDATA\Microsoft\Windows\WER\ReportQueue",
            "C:\Windows\Minidump",
            "C:\Windows\MEMORY.DMP"
        )
        foreach ($p in $werPaths) {
            $totalFreed += Remove-Items -Path $p -Description "WER/CrashDump"
        }
        
        # ── 7. Recycle Bin ────────────────────────────────────────────────────────────
        
        Write-Log "`n[7] Recycle Bin"
        if ($DryRun) {
            Write-Log "  [DRY-RUN] Would empty the Recycle Bin"
        } else {
            Clear-RecycleBin -Force -ErrorAction SilentlyContinue
            Write-Log "  Recycle Bin emptied"
        }
        
        # ── 8. Old Windows.old / upgrade leftovers ────────────────────────────────────
        
        Write-Log "`n[8] Windows.old / upgrade leftovers"
        $oldPaths = @("C:\Windows.old", "C:\`$Windows.~BT", "C:\`$Windows.~WS")
        foreach ($p in $oldPaths) {
            $totalFreed += Remove-Items -Path $p -Description "Windows upgrade remnants"
        }
        
        # ── 9. Prefetch ───────────────────────────────────────────────────────────────
        
        Write-Log "`n[9] Prefetch files (older than 30 days)"
        $totalFreed += Remove-Items -Path "C:\Windows\Prefetch" -Description "Prefetch" -Filter "*.pf" -OlderThanDays 30
        
        # ── 10. User profile temp / caches ────────────────────────────────────────────
        
        Write-Log "`n[10] All User Profile Temp Directories"
        Get-ChildItem "C:\Users" -Directory -ErrorAction SilentlyContinue | ForEach-Object {
            $userTemp = Join-Path $_.FullName "AppData\Local\Temp"
            $totalFreed += Remove-Items -Path $userTemp -Description "User Temp ($($_.Name))" -OlderThanDays 1
        }
        
        # ── 11. Built-in Disk Cleanup (cleanmgr) ──────────────────────────────────────
        
        Write-Log "`n[11] Built-in Disk Cleanup Utility (cleanmgr)"
        if ($DryRun) {
            Write-Log "  [DRY-RUN] Would run cleanmgr /sagerun:1 after configuring sageset"
        } else {
            # Pre-configure all cleanmgr categories silently via sageset
            $regBase = "HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\Explorer\VolumeCaches"
            $categories = @(
                "Active Setup Temp Folders","BranchCache","Content Indexer Cleaner",
                "Device Driver Packages","Downloaded Program Files","GameNewsFiles",
                "GameStatisticsFiles","GameUpdateFiles","Internet Cache Files",
                "Memory Dump Files","Offline Pages Files","Old ChkDsk Files",
                "Previous Installations","Recycle Bin","Service Pack Cleanup",
                "Setup Log Files","System error memory dump files",
                "System error minidump files","Temporary Files","Temporary Setup Files",
                "Temporary Sync Files","Thumbnail Cache","Update Cleanup",
                "Upgrade Discarded Files","User file versions","Windows Defender",
                "Windows Error Reporting Archive Files","Windows Error Reporting Files",
                "Windows Error Reporting Queue Files","Windows Error Reporting Temp Files",
                "Windows ESD installation files","Windows Upgrade Log Files"
            )
            foreach ($cat in $categories) {
                $key = Join-Path $regBase $cat
                if (Test-Path $key) {
                    Set-ItemProperty -Path $key -Name StateFlags0001 -Value 2 -Type DWORD -ErrorAction SilentlyContinue
                }
            }
            Write-Log "  Running cleanmgr /sagerun:1 ..."
            Start-Process -FilePath cleanmgr.exe -ArgumentList "/sagerun:1" -Wait -NoNewWindow
            Write-Log "  cleanmgr completed"
        }
        
        # ── Summary ───────────────────────────────────────────────────────────────────
        
        $driveAfter = (Get-PSDrive C).Free
        $actualFreed = $driveAfter - $driveBefore
        
        Write-Log "`n$("=" * 60)"
        Write-Log "SUMMARY"
        Write-Log ("=" * 60)
        Write-Log "Mode              : $(if ($DryRun) {'DRY RUN (no files deleted)'} else {'LIVE'})"
        Write-Log "Estimated savings : $(Format-Bytes $totalFreed)"
        if (-not $DryRun) {
            Write-Log "Actual space freed: $(Format-Bytes $actualFreed)"
            Write-Log "Free space on C:  : $(Format-Bytes $driveAfter)"
        }
        Write-Log "Log saved to      : $LogPath"
        Write-Log ("=" * 60)
        
        }
        
        Disk-Cleanup -DryRun $true
        
        $StartData = @()
        get-volume -DriveLetter $ENV:SystemDrive.Replace(':','') | foreach {
            $StartData += [PSCustomObject]@{
                Total = [math]::Round($_.Size / 1GB,2)
                Remaining = [math]::Round($_.SizeRemaining / 1GB, 2)
                Used = [math]::Round(($_.Size - $_.SizeRemaining) / 1GB, 2)
            }
        }
        
        Write-Host "Would you like to run this again for real?"
        $choice = read-host -prompt "Type YES and press enter to continue."
        if ($choice -eq "YES") {
          Disk-Cleanup -DryRun $false -LogPath "C:\RTSupport\Logs\$(get-date -format 'yyyyMMddHHmmss')_disk-cleanup.log"
          
          $EndData = @()
          get-volume -DriveLetter $ENV:SystemDrive.Replace(':','') | foreach {
              $EndData += [PSCustomObject]@{
                  Total = [math]::Round($_.Size / 1GB,2)
                  Remaining = [math]::Round($_.SizeRemaining / 1GB, 2)
                  Used = [math]::Round(($_.Size - $_.SizeRemaining) / 1GB, 2)
              }
          }
    }
}

###############################################################################
###                                                                         ###
###    PCDIAG-IPLookupToClipboard                                           ###
###                                                                         ###
###    Copy IP Information to windows clipboard to paste into excel         ###
###                                                                         ###
###############################################################################

function PCDIAG-IPLookupToClipboard {
    param (
        $IPAddress
    )
    $IPInfo = irm http://ip-api.com/json/$IPAddress
    $Output = "$($IPInfo.query)`t$($IPInfo.country)`t$($IPInfo.countrycode)`t$($IPInfo.region)`t$($IPInfo.regionName)`t$($IPInfo.city)`t$($IPInfo.zip)`t$($IPInfo.lat)`t$($IPInfo.lon)`t$($IPInfo.timezone)`t$($IPInfo.isp)`t$($IPInfo.org)`t$($IPInfo.as)"
    Set-Clipboard $Output
    Write-Host "Results copied to clipboard"
}



###############################################################################
###                                                                         ###
###    PCDiag-GetDomainSPFConfiguration                                     ###
###                                                                         ###
###    Check a Domain's SPF Setup                                           ###
###                                                                         ###
###############################################################################



function PCDiag-GetDomainSPFConfiguration {

    [CmdletBinding()]
    param(
        [Parameter(Mandatory, ValueFromPipeline, ValueFromPipelineByPropertyName)]
        [Alias("Name","DomainName")]
        [string]$Domain
    )

    begin {

        function Get-SPFRecord {
            param([string]$Domain)

            try {
                $records = Resolve-DnsName -Name $Domain -Type TXT -ErrorAction Stop

                return $records | Where-Object {
                    ($_.Strings -join '') -match '^v=spf1'
                }
            }
            catch {
                return $null
            }
        }

        function Test-Include {

            param(
                [string]$Domain,
                [hashtable]$Visited
            )

            if ($Visited.ContainsKey($Domain)) {
                return
            }

            $Visited[$Domain] = $true

            $spf = Get-SPFRecord $Domain

            if (!$spf) {
                return
            }

            $record = ($spf.Strings -join '')

            foreach ($include in ([regex]::Matches($record,'include:([^\s]+)'))) {

                $script:LookupCount++

                Test-Include -Domain $include.Groups[1].Value -Visited $Visited
            }

            foreach ($pattern in @(
                    'include:',
                    'exists:',
                    'redirect=',
                    ' a:',
                    ' mx'
                )) {

                $script:LookupCount += ([regex]::Matches($record,[regex]::Escape($pattern))).Count
            }
        }
    }

    process {

        $script:LookupCount = 0
        $visited = @{}

        $Issues = New-Object System.Collections.Generic.List[string]
        $Warnings = New-Object System.Collections.Generic.List[string]

        $spf = Get-SPFRecord $Domain

        if (!$spf) {

            return [pscustomobject]@{
                Domain      = $Domain
                Exists      = $false
                Score       = 0
                Health      = "Critical"
                SPFRecord   = $null
                LookupCount = 0
                Issues      = @("No SPF record found.")
                Warnings    = @()
            }
        }

        if ($spf.Count -gt 1) {
            $Issues.Add("Multiple SPF records detected.")
        }

        $record = ($spf.Strings -join '')

        if ($record.Length -gt 450) {
            $Warnings.Add("Record is approaching the DNS length limit.")
        }

        if ($record -match "\+all") {
            $Issues.Add("'+all' completely disables SPF protection.")
        }

        if ($record -match "\?all") {
            $Issues.Add("'?all' (Neutral) is not recommended.")
        }

        if ($record -match "~all") {
            $Warnings.Add("Using SoftFail (~all). Consider '-all' if possible.")
        }

        if ($record -notmatch "[-~?+]all") {
            $Issues.Add("Missing ALL mechanism.")
        }

        if ($record -match "\sptr") {
            $Issues.Add("Uses deprecated PTR mechanism.")
        }

        $includes = [regex]::Matches($record,'include:([^\s]+)')

        if ($includes.Count -gt 5) {
            $Warnings.Add("High number of include statements ($($includes.Count)).")
        }

        $duplicates = $record.Split(" ") |
            Group-Object |
            Where-Object Count -gt 1

        foreach ($dup in $duplicates) {
            $Warnings.Add("Duplicate mechanism: $($dup.Name)")
        }

        Test-Include -Domain $Domain -Visited $visited

        if ($LookupCount -gt 10) {
            $Issues.Add("SPF exceeds the RFC limit of 10 DNS lookups.")
        }
        elseif ($LookupCount -gt 8) {
            $Warnings.Add("SPF is close to the 10 lookup limit.")
        }

        $score = 100
        $score -= ($Issues.Count * 20)
        $score -= ($Warnings.Count * 5)

        if ($score -lt 0) { $score = 0 }

        $health = switch ($score) {
            {$_ -ge 95} { "Excellent"; break }
            {$_ -ge 80} { "Good"; break }
            {$_ -ge 60} { "Fair"; break }
            default     { "Poor" }
        }

        [pscustomobject]@{
            Domain          = $Domain
            Exists          = $true
            Health          = $health
            Score           = $score
            SPFRecord       = $record
            LookupCount     = $LookupCount
            IncludeCount    = $includes.Count
            IssueCount      = $Issues.Count
            WarningCount    = $Warnings.Count
            Issues          = $Issues
            Warnings        = $Warnings
            RecommendedFail = ($record -match "-all")
        }
    }
}

###############################################################################
###                                                                         ###
###    PCDiag-GetDomainDMARCConfiguration                                   ###
###                                                                         ###
###    Check a Domain's DMARC Config                                        ###
###                                                                         ###
###############################################################################

function PCDiag-GetDomainDMARCConfiguration {

    [CmdletBinding()]
    param(
        [Parameter(Mandatory,ValueFromPipeline,ValueFromPipelineByPropertyName)]
        [Alias("Name","DomainName")]
        [string]$Domain
    )

    begin {

        function Get-DMARCRecord {
            param([string]$Domain)

            try {

                Resolve-DnsName `
                    -Name "_dmarc.$Domain" `
                    -Type TXT `
                    -ErrorAction Stop |
                Where-Object {
                    ($_.Strings -join "") -match "^v=DMARC1"
                }

            }
            catch {
                $null
            }
        }

    }

    process {

        $Issues   = [System.Collections.Generic.List[string]]::new()
        $Warnings = [System.Collections.Generic.List[string]]::new()

        $Record = Get-DMARCRecord $Domain

        if(!$Record){

            return [pscustomobject]@{
                Domain          = $Domain
                Exists          = $false
                Health          = "Critical"
                Score           = 0
                DMARCRecord     = $null
                Policy          = $null
                AlignmentDKIM   = $null
                AlignmentSPF    = $null
                Rua             = @()
                Ruf             = @()
                IssueCount      = 1
                WarningCount    = 0
                Issues          = @("No DMARC record found.")
                Warnings        = @()
            }

        }

        if($Record.Count -gt 1){
            $Issues.Add("Multiple DMARC records detected.")
        }

        $Text = ($Record.Strings -join "")

        $Tags = @{}

        foreach($pair in $Text -split ";"){

            if($pair.Trim() -match "^(.+?)=(.+)$"){

                $Tags[$Matches[1].Trim().ToLower()] =
                    $Matches[2].Trim()

            }

        }

        #
        # Required Version
        #

        if($Tags.v -ne "DMARC1"){
            $Issues.Add("Invalid DMARC version.")
        }

        #
        # Policy
        #

        if(!$Tags.ContainsKey("p")){
            $Issues.Add("Missing required policy (p=).")
        }

        switch($Tags.p){

            "none" {
                $Warnings.Add("Policy is set to 'none'. Monitoring only.")
            }

            "quarantine" {
            }

            "reject" {
            }

            default {
                $Issues.Add("Invalid policy value.")
            }

        }

        #
        # Percentage
        #

        if($Tags.ContainsKey("pct")){

            try{

                $pct=[int]$Tags.pct

                if($pct -lt 100){
                    $Warnings.Add("Policy only applies to $pct% of messages.")
                }

            }
            catch{
                $Issues.Add("Invalid pct value.")
            }

        }

        #
        # rua reports
        #

        if(!$Tags.ContainsKey("rua")){
            $Warnings.Add("Aggregate reporting (rua) not configured.")
        }

        #
        # ruf reports
        #

        if(!$Tags.ContainsKey("ruf")){
            $Warnings.Add("Forensic reporting (ruf) not configured.")
        }

        #
        # Alignment
        #

        if($Tags.ContainsKey("adkim")){

            if($Tags.adkim -notin @("r","s")){
                $Issues.Add("Invalid DKIM alignment mode.")
            }

            if($Tags.adkim -eq "r"){
                $Warnings.Add("DKIM alignment is relaxed.")
            }

        }

        if($Tags.ContainsKey("aspf")){

            if($Tags.aspf -notin @("r","s")){
                $Issues.Add("Invalid SPF alignment mode.")
            }

            if($Tags.aspf -eq "r"){
                $Warnings.Add("SPF alignment is relaxed.")
            }

        }

        #
        # Report Interval
        #

        if($Tags.ContainsKey("ri")){

            try{

                if([int]$Tags.ri -gt 86400){
                    $Warnings.Add("Report interval exceeds 24 hours.")
                }

            }
            catch{
                $Issues.Add("Invalid report interval.")
            }

        }

        #
        # Unknown Tags
        #

        $KnownTags=@(
            "v","p","sp","pct",
            "rua","ruf",
            "ri","fo",
            "adkim","aspf"
        )

        foreach($Tag in $Tags.Keys){

            if($Tag -notin $KnownTags){

                $Warnings.Add("Unknown tag: $Tag")

            }

        }

        #
        # Health Score
        #

        $Score=100

        $Score-=($Issues.Count*20)
        $Score-=($Warnings.Count*5)

        if($Score -lt 0){
            $Score=0
        }

        $Health=switch($Score){

            {$_ -ge 95} {"Excellent";break}
            {$_ -ge 80} {"Good";break}
            {$_ -ge 60} {"Fair";break}
            default     {"Poor"}

        }

        [pscustomobject]@{

            Domain          = $Domain
            Exists          = $true
            Health          = $Health
            Score           = $Score

            DMARCRecord     = $Text

            Policy          = $Tags.p
            SubdomainPolicy = $Tags.sp

            AlignmentDKIM   = $Tags.adkim
            AlignmentSPF    = $Tags.aspf

            Percentage      = $Tags.pct
            ReportInterval  = $Tags.ri

            Rua             = if($Tags.rua){$Tags.rua -split ","}else{@()}
            Ruf             = if($Tags.ruf){$Tags.ruf -split ","}else{@()}

            IssueCount      = $Issues.Count
            WarningCount    = $Warnings.Count

            Issues          = $Issues
            Warnings        = $Warnings

            Enforced        = ($Tags.p -eq "reject")
        }

    }

}


###############################################################################
###                                                                         ###
###    PCDiag-GetDomainDKIMConfiguration                                    ###
###                                                                         ###
###    Check a Domain's DKIM Config                                         ###
###                                                                         ###
###############################################################################


function PCDiag-GetDomainDKIMConfiguration {

    [CmdletBinding()]
    param(
        [Parameter(Mandatory,ValueFromPipeline,ValueFromPipelineByPropertyName)]
        [Alias("Name","DomainName")]
        [string]$Domain,

        [string[]]$Selectors = @(
            "selector1",
            "selector2",
            "default",
            "google",
            "k1",
            "dkim",
            "mail",
            "smtp",
            "s1",
            "s2"
        )
    )

    begin {

        function Get-DKIMRecord {

            param(
                [string]$Domain,
                [string]$Selector
            )

            try {

                Resolve-DnsName `
                    -Name "$Selector._domainkey.$Domain" `
                    -Type TXT `
                    -ErrorAction Stop |
                Where-Object {
                    ($_.Strings -join "") -match "v=DKIM1"
                }

            }
            catch {
                $null
            }

        }

    }

    process {

        $Issues   = [System.Collections.Generic.List[string]]::new()
        $Warnings = [System.Collections.Generic.List[string]]::new()
        $Found    = [System.Collections.Generic.List[object]]::new()

        foreach($Selector in $Selectors){

            $Record = Get-DKIMRecord -Domain $Domain -Selector $Selector

            if(!$Record){
                continue
            }

            if($Record.Count -gt 1){
                $Warnings.Add("Multiple DKIM records found for selector '$Selector'.")
            }

            $Text = ($Record.Strings -join "")

            $Tags=@{}

            foreach($Pair in $Text -split ";"){

                if($Pair.Trim() -match "^(.+?)=(.+)$"){

                    $Tags[$Matches[1].Trim().ToLower()] =
                        $Matches[2].Trim()

                }

            }

            #
            # Version
            #

            if($Tags.v -ne "DKIM1"){
                $Issues.Add("Invalid DKIM version for selector '$Selector'.")
            }

            #
            # Public Key
            #

            if(!$Tags.ContainsKey("p")){
                $Issues.Add("Missing public key for selector '$Selector'.")
            }
            elseif([string]::IsNullOrWhiteSpace($Tags.p)){
                $Warnings.Add("Selector '$Selector' appears revoked (empty public key).")
            }

            #
            # Key Type
            #

            if($Tags.ContainsKey("k")){

                if($Tags.k -ne "rsa"){
                    $Warnings.Add("Selector '$Selector' uses uncommon key type '$($Tags.k)'.")
                }

            }

            #
            # Service Type
            #

            if($Tags.ContainsKey("s")){

                if($Tags.s -notmatch "email|\*"){
                    $Warnings.Add("Selector '$Selector' has unexpected service type '$($Tags.s)'.")
                }

            }

            #
            # Flags
            #

            if($Tags.ContainsKey("t")){

                if($Tags.t -match "y"){
                    $Warnings.Add("Selector '$Selector' is in testing mode.")
                }

            }

            #
            # Estimate Key Size
            #

            $EstimatedBits = $null

            if($Tags.ContainsKey("p")){

                $EstimatedBits = [Math]::Round(($Tags.p.Length * 6) / 8) * 8

                if($EstimatedBits -lt 1024){
                    $Issues.Add("Selector '$Selector' appears to use a weak key (<1024 bits).")
                }
                elseif($EstimatedBits -lt 2048){
                    $Warnings.Add("Selector '$Selector' appears to use a 1024-bit key.")
                }

            }

            $Found.Add([PSCustomObject]@{

                Selector = $Selector
                KeyType  = $Tags.k
                KeyBits  = $EstimatedBits
                Flags    = $Tags.t
                Service  = $Tags.s
                Record   = $Text

            })

        }

        if($Found.Count -eq 0){

            return [PSCustomObject]@{

                Domain          = $Domain
                Exists          = $false
                Health          = "Critical"
                Score           = 0

                SelectorCount   = 0
                Selectors       = @()

                IssueCount      = 1
                WarningCount    = 0

                Issues          = @("No DKIM records found using the supplied selectors.")
                Warnings        = @()

            }

        }

        #
        # Score
        #

        $Score = 100

        $Score -= ($Issues.Count * 20)
        $Score -= ($Warnings.Count * 5)

        if($Score -lt 0){
            $Score = 0
        }

        $Health = switch($Score){

            {$_ -ge 95} {"Excellent";break}
            {$_ -ge 80} {"Good";break}
            {$_ -ge 60} {"Fair";break}
            default     {"Poor"}

        }

        [PSCustomObject]@{

            Domain          = $Domain
            Exists          = $true

            Health          = $Health
            Score           = $Score

            SelectorCount   = $Found.Count
            Selectors       = $Found

            IssueCount      = $Issues.Count
            WarningCount    = $Warnings.Count

            Issues          = $Issues
            Warnings        = $Warnings

        }

    }

}

###############################################################################
###                                                                         ###
###    PCDiag-GetDomainWhoisRDAP                                            ###
###                                                                         ###
###    Check a Domain's Registration using RDAP                             ###
###                                                                         ###
###############################################################################

function PCDiag-GetDomainWhoisRDAP {
    param (
        $Domain
    )
    return irm "https://rdap.org/domain/$($Domain)"
}

###############################################################################
###                                                                         ###
###    PCDIAG-CheckEmailConfigudation                                       ###
###                                                                         ###
###    Check a Domain's Email configuration                                 ###
###                                                                         ###
###############################################################################

function PCDIAG-CheckEmailDomainSetup {
    param (
        $Domain
    )
    $DKIM  = PCDiag-GetDomainDKIMConfiguration -Domain $domain
    $DMARC = PCDiag-GetDomainDMARCConfiguration -Domain $domain
    $SPF   = PCDiag-GetDomainSPFConfiguration -Domain $domain

    $DomainReport = [PSCustomObject]@{
        Domain          =   $Domain
        EmailSecurity   =   [PSCustomObject]@{
            SPF = $SPF
            DMARC = $DMARC
            DKIM = $DKIM
        }
        Overall         =   [PSCustomObject]@{
            Score       =   ($SPF.Score, $DKIM.Score, $DMARC.Score | Measure-Object -Average).Average
            Health      =   switch ($DomainReport.Overall.Score) {
                                {$_ -ge 95} { "Excellent"; break }
                                {$_ -ge 80} { "Good"; break }
                                {$_ -ge 60} { "Fair"; break }
                                default     { "Poor" }
                            }
        }
    }
    return $DomainReport
}
